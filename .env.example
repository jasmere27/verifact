# Copy to .env and fill in. Never commit .env.

# --- AI provider ---
OPEN_AI_API_KEY=
# Optional: override the Spring AI default chat model
# SPRING_AI_OPENAI_CHAT_MODEL=

# --- Web search ---
# tavily | google | auto (default: Tavily if TAVILY_API_KEY is set, else Google)
# SEARCH_PROVIDER=auto
# Tavily: https://app.tavily.com (free tier: 1,000 searches/month)
TAVILY_API_KEY=
# Legacy Google Custom Search: closed to new customers, discontinued 2027-01-01. Leave empty if unused.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE=

# --- ResearchFact (optional) ---
# Contact email sent to Crossref (polite pool) and in the User-Agent
# SCHOLARLY_CONTACT_EMAIL=
# OpenAlex API key (optional; raises the free daily budget): https://openalex.org
# OPENALEX_API_KEY=

# --- Images ---
# A vision model reads uploaded images (the configured chat model must accept images); OCR is the fallback.
# false = OCR only.
# VISION_ENABLED=true

# --- Audio transcription (optional) ---
# Google Cloud Speech uses Application Default Credentials, e.g. a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Supabase Postgres ---
# Supabase dashboard -> Connect -> "Session pooler" (IPv4; port 5432). The direct connection is IPv6-only
# and does not work from Render. Do NOT use the transaction pooler (port 6543).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- CORS: comma-separated origins allowed to call the API (e.g. your Cloudflare Pages URL) ---
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Abuse and cost limits (defaults shown) ---
# MAX_INPUT_CHARS=10000
# MAX_CONTENT_CHARS=20000
# RATE_LIMIT_PER_IP_PER_MINUTE=5
# RATE_LIMIT_PER_IP_PER_DAY=50
# RATE_LIMIT_GLOBAL_PER_DAY=1000
# true only behind a proxy that appends X-Forwarded-For (Render sets this in render.yaml)
# TRUST_FORWARDED_FOR=false

# --- History API: exposes every submission to anyone; local development only ---
# HISTORY_API_ENABLED=false

# --- OCR (set automatically in Docker) ---
# TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata
