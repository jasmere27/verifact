OPEN_AI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE=

# Supabase Postgres connection (Project Settings -> Database -> Connection string)
SUPABASE_DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Comma-separated list of origins allowed to call the API (e.g. your Cloudflare Pages URL)
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
